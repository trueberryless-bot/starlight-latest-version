---
import { Badge } from "@astrojs/starlight/components";
import config from "virtual:starlight-latest-version/config";

import VersionBadge from "./VersionBadge.astro";
---

{config.showInSiteTitle === "true" && <VersionBadge />}
{config.showInSiteTitle === "deferred" && (
  <VersionBadge server:defer useCache>
    <Badge text="Loading..." variant="default" size="medium" slot="fallback" />
  </VersionBadge>
)}
{config.showInSiteTitle !== "false" && <style is:global>
  .title-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
</style>}
